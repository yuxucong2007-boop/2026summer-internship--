/* ============================================
   测风激光雷达控制系统 - 全局样式表
   风格：深色科技感 + 高对比度
   ============================================ */

/* 主窗口 */
QMainWindow {
    background-color: #1e1e1e;
}

/* 菜单栏 */
QMenuBar {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border-bottom: 1px solid #3d3d3d;
    padding: 2px 4px;
}

QMenuBar::item:selected {
    background-color: #0078d4;
    color: white;
    border-radius: 3px;
}

QMenuBar::item:pressed {
    background-color: #005a9e;
}

/* 菜单 */
QMenu {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: white;
    padding-left: 16px;
}

QMenu::separator {
    height: 1px;
    background: #3d3d3d;
    margin: 4px 0;
}

/* 左侧导航树 */
QTreeWidget {
    background-color: #252525;
    color: #e0e0e0;
    border-right: 2px solid #0078d4;
    outline: none;
    font-size: 11px;
}

QTreeWidget::item {
    padding: 6px 4px;
    border-radius: 3px;
}

QTreeWidget::item:selected {
    background-color: #0078d4;
    color: white;
    font-weight: bold;
}

QTreeWidget::item:hover {
    background-color: #404040;
}

QTreeWidget::item:open {
    background-color: #2a2a2a;
}

/* 状态栏 */
QStatusBar {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border-top: 2px solid #0078d4;
    padding: 3px 0;
}

QStatusBar::item {
    border: none;
    padding: 0 4px;
}

QStatusBar QLabel {
    padding: 2px 6px;
    margin: 0 2px;
}

/* 标签 */
QLabel {
    color: #e0e0e0;
}

/* 分组框 */
QGroupBox {
    color: #0078d4;
    border: 1px solid #0078d4;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px;
}

/* 按钮 */
QPushButton {
    background-color: #0078d4;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton:hover {
    background-color: #1084e0;
}

QPushButton:pressed {
    background-color: #005a9e;
}

QPushButton:disabled {
    background-color: #404040;
    color: #808080;
}

/* 分割器 */
QSplitter::handle {
    background-color: #3d3d3d;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #0078d4;
}

/* 滚动条 */
QScrollBar:vertical {
    background-color: #2a2a2a;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #555555;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #0078d4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #2a2a2a;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #555555;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #0078d4;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}
